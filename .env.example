# ----------------------------------------------------------------------------
# Linkdexing - Frontend (Create React App)
# Template. Copy to .env (cp .env.example .env) and fill in the real values.
# Keep this file committed with EMPTY values only - never commit real secrets.
#
# NOTE: only variables prefixed with REACT_APP_ are exposed to the browser,
# and they are baked into the build - so never put a private secret here.
# Restart the dev server after changing this file.
# ----------------------------------------------------------------------------

# Dev server port. CRA defaults to 3000 if empty.
PORT=

# Base URL of the backend API, no trailing slash (src/api/index.js:3)
# e.g. https://api.linkdexing.com
REACT_APP_BASE_URL=

# Google reCAPTCHA v3 *site* key - public (src/App.jsx:120)
# Its private pair is RECAPTCHA_SECRET_KEY in backend/.env
REACT_APP_RECAPTCHA_SITE_KEY=

# --- PayPal (src/pages/site/BuyCreditsPage.jsx) ------------------------------
# Client id only - public by design, safe in a browser bundle. The secret
# lives only in backend/.env and must never appear here.
REACT_APP_PAYPAL_CLIENT_ID=
